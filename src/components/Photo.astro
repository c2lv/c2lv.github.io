---
/**
 * 인화된 사진의 그림 부분. 커버 사진이 있으면 그 사진, 없으면 시대 배경지를 찍은 빈 사진.
 * 오른쪽 아래에 필름 카메라 날짜 각인이 찍힌다. 인화지 테두리와 캡션은 감싸는 쪽이 만든다.
 */
import { Image } from 'astro:assets';
import { formatCameraDate, type Era, type LifeEvent } from '../lib/archive';
import { eraBackdropStyle } from '../lib/theme';

interface Props {
  event: LifeEvent;
  /** 빈 사진의 배경지 색을 이 시대 것으로 고정한다. 없으면 주변(현재 시대) 배경지를 따른다. */
  era?: Era;
  sizes: string;
  widths: number[];
  eager?: boolean;
  class?: string;
}

const { event, era, sizes, widths, eager = false, class: className } = Astro.props;
const { cover, coverAlt, date } = event.data;
---

<div class:list={['photo', !cover && 'backdrop', className]} style={era ? eraBackdropStyle(era) : undefined}>
  {
    cover && (
      <Image
        class="photo-img"
        src={cover}
        alt={coverAlt ?? ''}
        widths={widths}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
      />
    )
  }
  <span class="datestamp" aria-hidden="true">{formatCameraDate(date)}</span>
</div>

<style>
  .photo {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 2;
  }

  .photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .datestamp {
    position: absolute;
    right: 8%;
    bottom: 7%;
  }
</style>
