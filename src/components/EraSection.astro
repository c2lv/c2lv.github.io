---
import { render } from 'astro:content';
import { formatPeriod, pad2, type EraWithEvents } from '../lib/archive';
import EventCard from './EventCard.astro';

interface Props {
  item: EraWithEvents;
}

const { era, chapter, items } = Astro.props.item;
const { Content } = await render(era);
const headingId = `era-${era.id}-title`;
---

<section
  class="era themed"
  id={`era-${era.id}`}
  data-era={era.id}
  data-title={era.data.title}
  data-period={formatPeriod(era)}
  aria-labelledby={headingId}
>
  <div class="era-inner">
    <!-- 현상소 사진 봉투: 파란 인쇄 양식 위에 손으로 적은 시대 정보 -->
    <header class="envelope">
      <p class="env-print env-head">
        <span>밤팔이 사진관 현상·인화</span>
        <span>봉투 {pad2(chapter)}</span>
      </p>
      <dl class="env-form">
        <div class="env-row env-row-name">
          <dt class="env-print">이름</dt>
          <dd><h2 class="era-title" id={headingId}>{era.data.title}</h2></dd>
        </div>
        <div class="env-row">
          <dt class="env-print">기간</dt>
          <dd class="written">{era.data.start}–{era.data.end ?? '지금'}</dd>
        </div>
        <div class="env-row">
          <dt class="env-print">매수</dt>
          <dd class="written">{items.length}장</dd>
        </div>
      </dl>
      <div class="env-memo">
        <p class="env-print">메모</p>
        {era.data.subtitle && <p class="written subtitle">{era.data.subtitle}</p>}
        <div class="intro"><Content /></div>
      </div>
    </header>

    {
      items.length > 0 ? (
        <ol class="line">
          {items.map((item) => (
            <EventCard item={item} era={era} />
          ))}
        </ol>
      ) : (
        <p class="empty">이 봉투는 아직 비어 있습니다.</p>
      )
    }
  </div>
</section>

<style>
  .era {
    padding: var(--space-16) var(--gutter) var(--space-24);
  }

  .era-inner {
    max-width: var(--content-width);
    margin-inline: auto;
  }

  /* ---------- 봉투 ---------- */

  .envelope {
    position: relative;
    margin-bottom: var(--space-16);
    padding: var(--space-8) var(--space-6) var(--space-6);
    background: var(--envelope);
    color: var(--ink);
    transform: rotate(-1deg);
    box-shadow:
      0 1px 1px rgb(0 0 0 / 0.2),
      0 18px 30px -16px rgb(0 0 0 / 0.65);
  }

  /* 봉투 덮개: 위쪽 접힌 삼각형 */
  .envelope::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: var(--space-6);
    background: color-mix(in srgb, var(--envelope) 88%, black);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }

  .env-print {
    color: var(--envelope-ink);
    font-size: 13px;
  }

  .env-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--envelope-ink);
  }

  .env-form {
    margin: 0;
  }

  .env-row {
    display: grid;
    grid-template-columns: 3em 1fr;
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-bottom: 1px solid color-mix(in srgb, var(--envelope-ink) 45%, transparent);
  }

  .env-row dd {
    margin: 0;
  }

  .era-title {
    font-size: clamp(34px, 9vw, 48px);
    line-height: 1.1;
  }

  .written {
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.3;
  }

  .env-memo {
    margin-top: var(--space-4);
  }

  .subtitle {
    margin-top: var(--space-1);
  }

  .intro {
    margin-top: var(--space-2);
    font-size: 14px;
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .intro :global(p + p) {
    margin-top: var(--space-2);
  }

  /* ---------- 건조 줄 (세로 모드: 왼쪽 세로줄) ---------- */

  .line {
    position: relative;
    display: grid;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
  }

  .line::before {
    content: '';
    position: absolute;
    left: calc(var(--rail-x) - 1px);
    top: calc(var(--space-8) * -1);
    bottom: 0;
    width: 2px;
    background: color-mix(in srgb, var(--fg) 55%, transparent);
    box-shadow: 1px 2px 2px rgb(0 0 0 / 0.25);
  }

  .empty {
    color: var(--muted);
  }

  /* ---------- 가로 모드 (src/scripts/timeline.ts가 html.is-horizontal 지정) ---------- */

  :global(html.is-horizontal) .era {
    flex: none;
    height: 100%;
    padding: 0;
  }

  :global(html.is-horizontal) .era-inner {
    display: flex;
    align-items: stretch;
    max-width: none;
    height: 100%;
    margin: 0;
    padding: var(--space-16) var(--space-12) var(--space-12) 6vw;
  }

  :global(html.is-horizontal) .envelope {
    flex: none;
    align-self: center;
    width: min(340px, 27vw);
    margin: 0 var(--space-8) 0 0;
    max-height: calc(100% - var(--space-8));
    overflow: hidden;
  }

  /* 가로 건조 줄: 화면 세로 가운데를 가로지른다 */
  :global(html.is-horizontal) .line {
    display: flex;
    gap: 0;
    height: 100%;
    padding-inline: var(--space-8);
  }

  :global(html.is-horizontal) .line::before {
    left: 0;
    right: 0;
    top: calc(50% - 1px);
    bottom: auto;
    width: auto;
    height: 2px;
  }
</style>
