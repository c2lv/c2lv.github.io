---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'C2LV — Life Archive',
  description = '삶의 흐름을 따라 걷는 개인 아카이브',
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
