---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  // html에 적용할 시대 테마 CSS 변수 (상세 페이지용)
  themeStyle?: string;
}

const {
  title = '밤팔이 사진관',
  description = '온라인에 남겨진 밤팔이 박현준의 흔적들을 모아 둔 아카이브입니다.',
  themeStyle,
} = Astro.props;
---

<!doctype html>
<html lang="ko" style={themeStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>

    <!--
      검색 색인·AI 학습 거부. public/robots.txt, public/.well-known/tdmrep.json과 함께 쓴다.
      GitHub Pages는 응답 헤더(X-Robots-Tag)를 지정할 수 없어 페이지마다 meta로 알린다.
    -->
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta name="tdm-reservation" content="1" />

    <!--
      글꼴: 간판 Do Hyeon, 본문 Gowun Dodum, 시대별 선택 Gowun Batang · Gaegu.
      날짜 각인 DSEG7은 global.css의 @font-face로 jsdelivr에서 받는다.
    -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Do+Hyeon&family=Gaegu:wght@700&family=Gowun+Batang:wght@400;700&family=Gowun+Dodum&display=swap"
    />

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
