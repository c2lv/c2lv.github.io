---
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import { formatDay, getPublicEvents, isoDay, type LifeEvent } from '../../lib/archive';
import { eraStyle } from '../../lib/theme';

export const getStaticPaths = (async () => {
  const events = await getPublicEvents();
  return events.map((event, i) => ({
    params: { id: event.id },
    props: { event, no: i + 1, total: events.length, prev: events[i - 1], next: events[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  event: LifeEvent;
  no: number;
  total: number;
  prev?: LifeEvent;
  next?: LifeEvent;
}

const { event, no, total, prev, next } = Astro.props;
const { title, date, summary, place, tags, sources, attachments } = event.data;
const videos = attachments.filter((a) => a.type === 'video');
const files = attachments.filter((a) => a.type !== 'video');
const era = await getEntry(event.data.era);
if (!era) throw new Error(`사건 "${event.id}"의 시대 "${event.data.era.id}"를 찾을 수 없습니다.`);
const { Content } = await render(event);
---

<Base title={`${title} — 밤팔이 사진관`} description={summary} themeStyle={eraStyle(era)}>
  <main class="container">
    <nav class="topbar" aria-label="사진 위치">
      <a href={`/#${event.id}`}>앨범으로 돌아가기</a>
      <span>{total}장 중 {no}번째 사진</span>
    </nav>

    <article class="enlargement">
      <Photo
        event={event}
        era={era}
        widths={[720, 1440]}
        sizes="(min-width: 768px) 720px, 100vw"
        eager
        class="big-photo"
      />

      <div class="back-of-print">
        <p class="when">
          <a href={`/#era-${era.id}`}>{era.data.title}</a>
          <time datetime={isoDay(date)}>{formatDay(date)}</time>
          {place && <span>{place}에서</span>}
        </p>
        <h1>{title}</h1>
        <p class="summary">{summary}</p>

        <div class="prose"><Content /></div>

        {
          attachments.length > 0 && (
            <section class="attachments" aria-labelledby="attachments-title">
              <h2 id="attachments-title">함께 보관한 자료</h2>
              {videos.map((v) => (
                <figure class="video">
                  <video controls preload="metadata" src={v.src} />
                  <figcaption>{v.title}</figcaption>
                </figure>
              ))}
              {files.length > 0 && (
                <ul class="files">
                  {files.map((f) => (
                    <li>
                      <a href={f.src} target="_blank" rel="noopener">
                        {f.title} (PDF)
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          )
        }

        {
          sources.length > 0 && (
            <section class="sources" aria-labelledby="sources-title">
              <h2 id="sources-title">기록이 남은 곳</h2>
              <ul>
                {sources.map((s) => (
                  <li>
                    {s.publisher && <span class="publisher">{s.publisher}</span>}
                    <a href={s.url} rel="noopener">
                      {s.title}
                    </a>
                    {s.archive && (
                      <a class="archive" href={s.archive} rel="noopener">
                        보존본 보기
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          tags.length > 0 && (
            <ul class="tags" aria-label="태그">
              {tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          )
        }
      </div>
    </article>

    <nav class="pager" aria-label="이전·다음 사진">
      {
        prev ? (
          <a class="prev" href={`/events/${prev.id}/`}>
            <span>이전 사진</span>
            {prev.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="next" href={`/events/${next.id}/`}>
            <span>다음 사진</span>
            {next.data.title}
          </a>
        )
      }
    </nav>
  </main>
</Base>

<style>
  main {
    padding-block: var(--space-8) var(--space-24);
  }

  .topbar {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    font-size: 14px;
    color: var(--muted);
  }

  .topbar a {
    color: var(--fg);
  }

  /* 크게 뽑은 사진: 인화지 테두리 안에 사진, 그 아래 같은 종이에 적은 이야기 */
  .enlargement {
    margin-top: var(--space-8);
    padding: 14px 14px 0;
    background: var(--paper);
    color: var(--ink);
    box-shadow:
      0 1px 1px rgb(0 0 0 / 0.25),
      0 24px 48px -20px rgb(0 0 0 / 0.7);
  }

  .enlargement :global(.big-photo .datestamp) {
    font-size: clamp(16px, 3vw, 22px);
  }

  .back-of-print {
    padding: var(--space-6) var(--space-2) var(--space-8);
  }

  @media (min-width: 640px) {
    .back-of-print {
      padding-inline: var(--space-6);
    }
  }

  .when {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    font-size: 14px;
    color: var(--ink-soft);
  }

  .when a {
    color: var(--envelope-ink);
  }

  h1 {
    margin-top: var(--space-2);
    font-size: clamp(32px, 7vw, 46px);
    line-height: 1.15;
  }

  .summary {
    margin-top: var(--space-3);
    font-size: 18px;
    color: var(--ink-soft);
  }

  .prose {
    max-width: 34em;
    margin-top: var(--space-6);
    font-size: 17px;
    line-height: 1.85;
  }

  .prose :global(p + p),
  .prose :global(p + ul),
  .prose :global(ul + p) {
    margin-top: var(--space-4);
  }

  .prose :global(img) {
    margin-block: var(--space-6);
  }

  /* 함께 보관한 자료: 영상은 바로 재생, 문서는 새 탭에서 열기 */
  .attachments {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px dashed color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .attachments h2 {
    font-size: 18px;
  }

  .video {
    margin: var(--space-3) 0 0;
  }

  .video video {
    display: block;
    width: 100%;
    background: var(--ink);
  }

  .video figcaption {
    margin-top: var(--space-1);
    font-size: 13px;
    color: var(--ink-soft);
  }

  .files {
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }

  .files a {
    color: var(--envelope-ink);
  }

  /* 기록이 남은 곳: 사진 뒷면에 붙인 출처 메모 */
  .sources {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px dashed color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .sources h2 {
    font-size: 18px;
  }

  .sources ul {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .sources li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    font-size: 15px;
  }

  .sources a {
    color: var(--envelope-ink);
  }

  .publisher {
    font-size: 13px;
    color: var(--ink-soft);
  }

  .archive {
    font-size: 13px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    color: var(--ink-soft);
  }

  .tags li {
    padding: 0 var(--space-3);
    border: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
    border-radius: 999px;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-12);
  }

  .pager a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.3;
  }

  .pager a span {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--muted);
  }

  .pager a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .next {
    text-align: right;
    grid-column: 2;
  }
</style>
