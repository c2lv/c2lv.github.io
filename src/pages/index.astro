---
import Base from '../layouts/Base.astro';
import EraSection from '../components/EraSection.astro';
import Photo from '../components/Photo.astro';
import { formatMonth, getTimeline, tiltOf } from '../lib/archive';
import { eraThemeCss } from '../lib/theme';

const timeline = await getTimeline();
const themeCss = eraThemeCss(timeline.eras.map((t) => t.era));

// 진열장에 거는 세 장: 첫 사진, 가운데쯤의 주요 사진, 가장 최근 사진.
// 진열장은 실제 사진이 있는 사건으로만 채운다 (사진이 하나도 없으면 전체 사건에서 고른다).
const everything = timeline.eras.flatMap((e) => e.items.map((item) => ({ ...item, era: e.era })));
const withPhoto = everything.filter((i) => i.event.data.cover);
const all = withPhoto.length > 0 ? withPhoto : everything;
const first = all[0];
const last = all[all.length - 1];
const middle =
  all.slice(1, -1).find((i, idx, arr) => i.event.data.importance === 3 && idx >= arr.length / 3) ??
  all[Math.floor(all.length / 2)];
const showcase = [first, middle, last].filter((x, i, arr) => x && arr.indexOf(x) === i);
---

<Base>
  <Fragment slot="head">
    <style is:inline set:html={themeCss} />
    <!--
      첫 화면이 그려지기 전에 모드를 정해 레이아웃이 튀지 않게 한다.
      미디어 쿼리는 src/scripts/timeline.ts의 HORIZONTAL_QUERY와 같아야 한다.
    -->
    <script is:inline>
      document.documentElement.classList.add('js-theme');
      if (
        matchMedia('(min-width: 900px) and (min-height: 640px) and (prefers-reduced-motion: no-preference)').matches
      ) {
        document.documentElement.classList.add('is-horizontal');
      }
    </script>
  </Fragment>

  <div class="progress" aria-hidden="true"><div class="progress-bar"></div></div>

  <p class="now" hidden aria-live="polite">
    <span class="now-title"></span>
    <span class="now-period"></span>
  </p>

  <header class="storefront">
    <div class="sign">
      <h1>
        <span class="sign-name">밤팔이</span>
        <span class="sign-shop">사진관</span>
      </h1>
      <p class="sign-sub">온라인에 남겨진 밤팔이 박현준의 흔적들을 모아 둔 아카이브입니다.</p>
    </div>

    <div class="window" aria-label="진열된 사진">
      {
        showcase.map((item, i) => (
          <a
            class={`window-print window-print-${i + 1}`}
            href={`/events/${item.event.id}/`}
            style={`--tilt: ${(i - 1) * 3 + tiltOf(item.no)}deg`}
          >
            <Photo
              event={item.event}
              era={item.era}
              widths={[480, 960]}
              sizes="(min-width: 900px) 320px, 70vw"
              eager
              class="window-photo"
            />
            <span class="window-caption">
              <span class="window-title">{item.event.data.title}</span>
              <span class="window-date">{formatMonth(item.event.data.date)}</span>
            </span>
          </a>
        ))
      }
    </div>

    <nav class="envelopes" aria-labelledby="envelopes-title">
      <h2 id="envelopes-title" class="visually-hidden">시대별 사진 봉투</h2>
      <ol>
        {
          timeline.eras.map(({ era, items }) => (
            <li>
              <a class="envelope-mini" href={`#era-${era.id}`}>
                <span class="envelope-mini-name">{era.data.title}</span>
                <span class="envelope-mini-meta">
                  {era.data.start}–{era.data.end ?? '지금'}
                  <br />
                  사진 {items.length}장
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </header>

  <main class="timeline">
    <div class="timeline-sticky">
      <div class="timeline-track">
        {timeline.eras.map((item) => <EraSection item={item} />)}
        <p class="track-end">다음 사진을 인화중입니다.</p>
      </div>
    </div>
  </main>

  <footer class="footer">
    <p>
      밤팔이 사진관 <a href="https://github.com/c2lv">GitHub</a>
    </p>
  </footer>
</Base>

<script>
  import '../scripts/timeline';
</script>

<style>
  /* ---------- 사진관 입구: 간판 + 진열장 + 봉투 ---------- */

  .storefront {
    /* 기울인 사진이 화면 밖으로 삐져나와 가로 스크롤이 생기지 않게 */
    overflow-x: clip;
    display: grid;
    gap: var(--space-12);
    max-width: 1240px;
    margin-inline: auto;
    padding: var(--space-16) var(--gutter) var(--space-16);
  }

  h1 {
    display: flex;
    flex-direction: column;
    line-height: 0.9;
  }

  .sign-name {
    font-size: clamp(32px, 7vw, 56px);
    color: var(--accent);
  }

  .sign-shop {
    font-size: clamp(96px, 30vw, 220px);
    letter-spacing: -0.02em;
  }

  .sign-sub {
    max-width: 24em;
    margin-top: var(--space-4);
    font-size: 17px;
    color: var(--muted);
  }

  /* 진열장: 세 장을 비스듬히 겹쳐 붙여 둔 쇼윈도. 각 사진의 제목 줄은 가려지지 않게 배치한다. */
  .window {
    position: relative;
    aspect-ratio: 1 / 1.05;
  }

  .window-print {
    position: absolute;
    display: block;
    width: 56%;
    padding: 10px 10px 0;
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    transform: rotate(var(--tilt));
    box-shadow:
      0 1px 1px rgb(0 0 0 / 0.25),
      0 14px 28px -10px rgb(0 0 0 / 0.55);
  }

  .window-print-1 {
    left: 0;
    top: 0;
    z-index: 1;
  }

  .window-print-2 {
    right: 0;
    top: 26%;
    z-index: 2;
  }

  .window-print-3 {
    left: 2%;
    top: 60%;
    width: 42%;
    z-index: 3;
  }

  .window-print:hover,
  .window-print:focus-visible {
    z-index: 4;
  }

  .window-caption {
    display: flex;
    flex-direction: column;
    padding: var(--space-2) 2px var(--space-3);
    line-height: 1.4;
  }

  .window-title {
    font-family: var(--font-sign);
    font-size: 18px;
  }

  .window-date {
    font-size: 13px;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .window-print:hover .window-title,
  .window-print:focus-visible .window-title {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* 사진이 현상액 속에서 떠오르듯: 첫 화면에서 한 번만 */
  @media (prefers-reduced-motion: no-preference) {
    .window-print :global(.window-photo) {
      animation: develop 2.6s cubic-bezier(0.3, 0.1, 0.2, 1) both;
    }

    .window-print-2 :global(.window-photo) {
      animation-delay: 0.5s;
    }

    .window-print-3 :global(.window-photo) {
      animation-delay: 1s;
    }
  }

  @keyframes develop {
    from {
      filter: brightness(2.4) contrast(0.25) sepia(0.6);
    }

    60% {
      filter: brightness(1.2) contrast(0.8) sepia(0.2);
    }
  }

  /* 봉투 꽂이 */
  .envelopes ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .envelope-mini {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-6) var(--space-4) var(--space-4);
    background: var(--envelope);
    color: var(--envelope-ink);
    text-decoration: none;
    box-shadow: 0 8px 16px -10px rgb(0 0 0 / 0.6);
    transition: transform 0.2s ease;
  }

  /* 봉투 덮개 접힌 선 */
  .envelope-mini::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: var(--space-4);
    background: linear-gradient(
      to bottom right,
      transparent 49%,
      color-mix(in srgb, var(--envelope-ink) 25%, transparent) 50%,
      transparent 51%
    ),
    linear-gradient(
      to bottom left,
      transparent 49%,
      color-mix(in srgb, var(--envelope-ink) 25%, transparent) 50%,
      transparent 51%
    );
    background-size: 50% 100%;
    background-position: left, right;
    background-repeat: no-repeat;
  }

  .envelope-mini:hover,
  .envelope-mini:focus-visible {
    transform: translateY(-6px);
  }

  .envelope-mini-name {
    font-family: var(--font-sign);
    font-size: 22px;
    line-height: 1.2;
  }

  .envelope-mini-meta {
    font-size: 13px;
    line-height: 1.5;
  }

  @media (min-width: 900px) {
    .storefront {
      grid-template-columns: 1fr 1.1fr;
      column-gap: var(--space-16);
      padding-block: var(--space-24) var(--space-16);
    }

    .sign {
      align-self: center;
    }

    .window {
      grid-row: span 2;
    }

    .envelopes {
      align-self: end;
    }

    .envelopes ol {
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    }
  }

  /* ---------- 타임라인 끝, 푸터 ---------- */

  .track-end {
    padding: var(--space-16) var(--gutter);
    text-align: center;
    font-family: var(--font-sign);
    font-size: 20px;
    color: var(--muted);
  }

  .footer {
    display: flex;
    justify-content: center;
    padding: var(--space-12) var(--gutter);
    font-size: 14px;
    color: var(--muted);
  }

  .footer a {
    margin-left: var(--space-3);
  }

  /* ---------- 진행 바, 지금 보는 봉투 ---------- */

  .progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    height: 3px;
    pointer-events: none;
  }

  .progress-bar {
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .now {
    position: fixed;
    top: var(--space-4);
    right: var(--gutter);
    z-index: 10;
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-1) var(--space-3);
    background: var(--envelope);
    color: var(--envelope-ink);
    font-size: 13px;
    box-shadow: 0 6px 12px -8px rgb(0 0 0 / 0.6);
  }

  .now[hidden] {
    display: none;
  }

  .now-title {
    font-family: var(--font-sign);
    font-size: 16px;
  }

  /* ---------- 가로 모드 ---------- */

  :global(html.is-horizontal) .timeline {
    position: relative;
  }

  :global(html.is-horizontal) .timeline-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    /* hidden이 아니라 clip: 포커스 이동 시 브라우저가 이 영역을 몰래 스크롤하지 않게 */
    overflow: clip;
  }

  :global(html.is-horizontal) .timeline-track {
    display: flex;
    width: max-content;
    height: 100%;
    will-change: transform;
  }

  :global(html.is-horizontal) .track-end {
    display: flex;
    align-items: center;
    padding-inline: var(--space-16) 12vw;
    writing-mode: vertical-rl;
  }
</style>
